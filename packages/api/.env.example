PORT=3010
DATABASE_URL=postgres://app:app@localhost:5450/app
# Postgres schema the entities live in. Leave blank for 'public'.
DATABASE_SCHEMA=
# Let the entities build the schema at boot. Set to false in production and run
# `pnpm migrate` instead; the app then refuses to start with migrations pending.
DATABASE_SYNCHRONIZE=true
CORS_ORIGIN=http://localhost:5173

# Where the SPA lives. Defaults to the first CORS_ORIGIN.
WEB_URL=http://localhost:5173
# Public API base (defaults to http://localhost:PORT).
API_URL=http://localhost:3010

LOG_LEVEL=info
LOG_PRETTY=true

STORAGE_ENDPOINT=http://localhost:9010
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_BUCKET=app
STORAGE_PUBLIC_URL=http://localhost:9010
STORAGE_MAX_UPLOAD_BYTES=26214400
